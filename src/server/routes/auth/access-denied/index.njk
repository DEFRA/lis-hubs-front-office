{% extends 'layouts/page.njk' %}

{% block content %}
  <h1 class="govuk-heading-xl">You do not have permission to use this service yet</h1>

  <p class="govuk-body">We're currently testing a new livestock service for a small group of invited users. Your account does not yet have access.</p>
  <p class="govuk-body">You can still use <a class="govuk-link" href="https://www.gov.uk/cattle-tracing-online">Cattle Tracing Service (CTS) Online</a>.</p>
  {% if signOutHref %}
    <a href="{{ signOutHref }}" role="button" draggable="false" class="govuk-button" data-module="govuk-button">Sign out</a>
  {% endif %}
{% endblock %}
